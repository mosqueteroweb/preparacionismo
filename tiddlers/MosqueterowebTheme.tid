title: MosqueterowebTheme
tags: $:/tags/Stylesheet

/* Tema Preparacionismo — paleta tierra/terracota */
:root {
  --tc-page-background: #faf6f0;
  --tc-sidebar-background: #efe6db;
  --tc-sidebar-border: #e2d6c8;
  --tc-tiddler-background: #fffdf9;
  --tc-tiddler-border: #e2d6c8;
  --tc-foreground: #3d3329;
  --tc-muted-foreground: #8a7d6d;
  --tc-accent-color: #a85c3a;
  --tc-background: #faf6f0;
  --tc-highlight: #a85c3a;
}

html body.tc-body {
  background: #faf6f0;
  color: #3d3329;
  font-family: -apple-system, system-ui, "Segoe UI", Roboto, sans-serif;
}

.tc-sidebar-scrollable {
  background: #efe6db;
}

.tc-tiddler-frame {
  background: #fffdf9;
  border: 1px solid #e2d6c8;
  border-radius: 6px;
  box-shadow: 0 1px 0 #e2d6c8;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  padding: 28px 32px 32px 32px;
}

.tc-tiddler-title {
  color: #3d3329;
  font-family: "Iowan Old Style", Palatino, Georgia, serif;
}

/* Etiquetas separadas */
.tc-tag-list-item {
  display: inline-block;
  margin: 0 0.4em 0.4em 0;
}
.tc-tag-label {
  display: inline-block;
  padding: 0.22em 0.65em;
  background: #efe6db;
  color: #a85c3a;
  border-radius: 6px;
  font-size: 0.78em;
  white-space: nowrap;
}

.tc-tab-buttons button.tc-tab-selected {
  border-bottom: 2px solid #a85c3a;
}

/* Vídeos adaptados a su resolución nativa (no full-width) */
.tc-body video {
  max-width: 100%;
  max-height: 70vh;
  width: auto;
  height: auto;
  display: block;
  margin: 0.5em 0;
  border-radius: 6px;
  background: #000;
}
.tc-body iframe {
  max-width: 100% !important;
  width: 100%;
  border-radius: 6px;
}
.tc-body img {
  max-width: 100%;
  height: auto;
}

/* ===== Vista solo lectura: ocultar edición/gestión ===== */
.tc-page-controls { display: none !important; }
.tc-tiddler-controls { display: none !important; }
.tc-sidebar-tabs { display: none !important; }

/* ===== Evitar overflow de texto y horizontal ===== */
html, body {
  overflow-x: hidden !important;
}
.tc-page-container,
.tc-page-container-inner,
.tc-story-river {
  max-width: 100% !important;
}
.tc-tiddler-title,
.tc-tiddler-title *,
.tc-tiddler-body,
.tc-tiddler-body * {
  white-space: normal !important;
  overflow-wrap: break-word !important;
  word-wrap: break-word !important;
  word-break: break-word !important;
}

/* ===== Móvil (<600px): padding del contenido y título más pequeño ===== */
@media (max-width: 599px) {
  .tc-titlebar {
    font-size: 1.6em !important;
  }
  .tc-story-river {
    padding: 16px 12px !important;
  }
  .tc-tiddler-frame {
    padding: 18px 16px !important;
  }
}

/* ===== Dos columnas (escritorio/tableta ≥600px): sidebar fijo, sin toggle ===== */
@media (min-width: 600px) {
  .tc-topbar { display: none !important; }

  .tc-page-container-inner {
    display: flex !important;
    align-items: stretch !important;
  }

  .tc-sidebar-scrollable {
    display: block !important;
    position: static !important;
    top: auto !important;
    left: auto !important;
    right: auto !important;
    bottom: auto !important;
    inset: auto !important;
    margin: 0 !important;
    flex: 0 0 280px !important;
    width: 280px !important;
    min-width: 280px !important;
    height: 100vh !important;
    overflow-y: auto !important;
    padding: 24px 16px !important;
    box-sizing: border-box;
  }

  .tc-story-river {
    flex: 1 1 auto !important;
    position: static !important;
    left: auto !important;
    top: auto !important;
    width: auto !important;
    max-width: 840px !important;
    margin: 0 auto !important;
    padding: 28px 24px !important;
    box-sizing: border-box;
  }
}
